<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100C">

    <com.appathy.netbuild.TopologyView
        android:id="@+id/topology"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="150dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1117"
        android:padding="7dp">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#C8D4E0" />

        <TextView
            android:id="@+id/tv_trust"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7FD1B9" />

        <TextView
            android:id="@+id/tv_cost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E0B15C" />

        <TextView
            android:id="@+id/tv_incident"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E5484D" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="146dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="12sp"
        android:textColor="#8B96A5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/chara_staff"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/staff_label"
                android:src="@drawable/chara_normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_label"
                android:textSize="11sp"
                android:paddingBottom="4dp"
                android:textColor="#7FD1B9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="vertical"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tv_bubble"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1E252E"
                android:padding="9dp"
                android:textSize="12sp"
                android:textColor="#D6DEE8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/chara_client"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/client_label"
                android:src="@drawable/chara_client" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/client_label"
                android:textSize="11sp"
                android:paddingBottom="4dp"
                android:textColor="#E0B15C" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
