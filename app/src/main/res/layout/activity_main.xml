<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100C">

    <com.appathy.netbuild.TopologyView
        android:id="@+id/topology"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="66dp"
        android:layout_marginBottom="156dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1117"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#C8D4E0" />

        <TextView
            android:id="@+id/tv_trust"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#7FD1B9" />

        <TextView
            android:id="@+id/tv_cost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E0B15C" />

        <TextView
            android:id="@+id/tv_incident"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E5484D" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:background="#0A0E13"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_features"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#7FD1B9" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/site_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="66dp"
        android:background="#0A0E13"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/site_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="150dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="12sp"
        android:textColor="#8B96A5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/chara_staff"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/staff_label"
                android:src="@drawable/chara_normal" />

            <TextView
                android:id="@+id/tv_ally_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#7FD1B9" />

            <TextView
                android:id="@+id/tv_ally_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:paddingBottom="2dp"
                android:textColor="#8B96A5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tv_bubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bubble_bg"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="#D6DEE8" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/client_label"
                android:src="@drawable/bubble_tail" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/chara_partner"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/client_label"
                android:src="@drawable/chara_client" />

            <TextView
                android:id="@+id/tv_partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#E0B15C" />

            <TextView
                android:id="@+id/tv_partner_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:paddingBottom="2dp"
                android:textColor="#8B96A5" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/title_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12100C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textColor="#7FD1B9"
                android:fontFamily="monospace"
                android:paddingTop="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_tagline"
                android:textSize="13sp"
                android:textColor="#8B96A5"
                android:paddingBottom="18dp" />

            <Button
                android:id="@+id/title_design"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_design" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_design_desc"
                android:textSize="12sp"
                android:textColor="#8B96A5"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/title_campaign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_campaign" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_campaign_desc"
                android:textSize="12sp"
                android:textColor="#8B96A5"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/title_study"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_study" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_study_desc"
                android:textSize="12sp"
                android:textColor="#8B96A5"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/title_real"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_real" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_real_desc"
                android:textSize="12sp"
                android:textColor="#8B96A5"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/title_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_results" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
